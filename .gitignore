# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Vendor font download (original .otf/.ttf, licence, specimens).
# Kept out of the repo on purpose: this repo is public so Pages can
# serve it for free, and Mishega's licence allows embedding the font in
# a personal site but not publishing the font itself. The build needs
# only src/fonts/Mishega.woff2, which is committed; keep the original
# download locally, and see README "Colors & fonts".
/fonts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
